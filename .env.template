# BytEM public deployment configuration
# env_setup.sh fills this in. install.html reproduces every key, in order, in its
# buildEnv() — change one and change the other, or the wizard emits a stale file.
NODE_ENV=production
BYTEM_INSTANCE=bytem

# Public instance addresses
BYTEM_DOMAIN=${BYTEM_DOMAIN}
DOMAIN_NAME=${BYTEM_DOMAIN}
DEFAULT_DEID_DOMAIN=${DEFAULT_DEID_DOMAIN}
MATRIX_DOMAIN=${MATRIX_DOMAIN}
MATRIX_SERVER=https://${MATRIX_DOMAIN}
SYNAPSE_PUBLIC_BASEURL=https://${MATRIX_DOMAIN}
MATRIX_SERVER_NAME=${MATRIX_DOMAIN}
MATRIX_SERVER_PROTOCOL=https
MATRIX_PORT=8008
API_HOST=https://${BYTEM_DOMAIN}
API_HOST_INTERNAL=http://localhost:3000
EXCHANGE_PORT=3000
EXCHANGE_SERVER_PROTOCOL=https
PWA_PORT=3002

# Domain Manager: repository publishing DEFAULT_DEID_DOMAIN's DEID documents
# (e.g. https://codeberg.org/Liberbyte/cities.app) and a write token for it.
DOMAIN_REPO=${DOMAIN_REPO}
DOMAIN_REPO_TOKEN=${DOMAIN_REPO_TOKEN}

# Matrix room aliases
SUPPLY_INDEX_ROOM_ALIAS="#bytem-supply-index-room:${MATRIX_DOMAIN}"
DEMAND_INDEX_ROOM_ALIAS="#bytem-demand-index-room:${MATRIX_DOMAIN}"

# Bot account. The bot and backend obtain and refresh the access token at runtime
# using these credentials; a token does not need to be pasted into this file.
BOT_USERNAME=${BOT_USERNAME}
BOT_PASSWORD=${BOT_PASSWORD}
BOT_USER_ID=@${BOT_USERNAME}:${MATRIX_DOMAIN}
BOT_USER_ACCESS_TOKEN=

# Interactive test/admin account. These credentials are deliberately separate
# from the bot credentials. Synapse creates both users on its first start.
TEST_USERNAME=${TEST_USERNAME}
TEST_PASSWORD=${TEST_PASSWORD}
MATRIX_ADMIN_USER=@${TEST_USERNAME}:${MATRIX_DOMAIN}
MATRIX_ADMIN_USERNAME=${TEST_USERNAME}
MATRIX_ADMIN_PASSWORD=${TEST_PASSWORD}
SYNAPSE_ADMIN_TOKEN=

# RabbitMQ
RABBITMQ_URL=amqp://${BYTEM_DOMAIN}:5672/bytem
RABBITMQ_DEFAULT_USER=${RABBITMQ_DEFAULT_USER}
RABBITMQ_DEFAULT_PASS=${RABBITMQ_DEFAULT_PASS}
RABBITMQ_DEFAULT_VHOST=bytem

# Solr
SOLR_URL=http://${BYTEM_DOMAIN}:8983
SOLR_USER=${SOLR_USER}
SOLR_PASSWORD=${SOLR_PASSWORD}

# PostgreSQL / Synapse
POSTGRES_HOST=bytem-synapse-db
POSTGRES_USER=synapse
POSTGRES_DB=synapse
POSTGRES_PASSWORD=${SYNAPSE_POSTGRES_PASSWORD}
SYNAPSE_POSTGRES_PASSWORD=${SYNAPSE_POSTGRES_PASSWORD}

# Stable secrets. Preserve these and the Docker volumes across upgrades.
REGISTRATION_SHARED_SECRET=${REGISTRATION_SHARED_SECRET}
SYNAPSE_MACAROON_SECRET_KEY=${SYNAPSE_MACAROON_SECRET_KEY}
SYNAPSE_FORM_SECRET=${SYNAPSE_FORM_SECRET}
JWT_SECRET=${JWT_SECRET}

# Federation
FEDERATION_ENABLED=true
MARKET_LIST=${MARKET_LIST}
FEDERATION_MARKET_LIST_URL=${FEDERATION_MARKET_LIST_URL}
FEDERATION_EXTRA_DOMAINS=${FEDERATION_EXTRA_DOMAINS}
FEDERATION_STRICT=${FEDERATION_STRICT}

# Application settings
BOT_PORT=4000
NODE_MODE=demand-supply
INDEX_AUTO_REINDEX=on
INDEX_AUTO_REINDEX_MS=600000
INDEX_AUTO_REINDEX_BATCH=500
INDEX_AUTO_REINDEX_COOLDOWN_MS=21600000
INDEX_AUTO_REINDEX_START_MS=120000
DQ_CONCURRENCY=2
DOMAIN_LIST=https://bytem.app/domain/domain-list.json
BYTEM_SCHEMA_URL=https://bytem.app/schema/
MAX_FILE_SIZE=52428800
ENABLE_LOGGING=true
SSL_EMAIL=${SSL_EMAIL}

# bytem-nginx writes an IP-truncated access log to logs/nginx/. A report placed there
# as traffic-report.html is served at /traffic-report.html?secret=<this value>.
TRAFFIC_REPORT_SECRET=${TRAFFIC_REPORT_SECRET}

# The PWA owns both the public and operator UI routes. Its runtime URLs are
# derived from API_HOST and MATRIX_SERVER by docker-compose.yaml.
NEXT_PUBLIC_DEMAND_PRODUCT_DEID=${NEXT_PUBLIC_DEMAND_PRODUCT_DEID}
