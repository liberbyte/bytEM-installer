# Generated from this template by ./env_setup.sh. Do not put secrets here.

# Deployment identity and public endpoints
DOMAIN_NAME=@PRODUCT_DOMAIN@
DEFAULT_DEID_DOMAIN=@DEFAULT_DEID_DOMAIN@
DOMAIN_REPO=https://codeberg.org/Liberbyte/cities.app
DOMAIN_REPO_TOKEN=@DOMAIN_REPO_TOKEN@
MATRIX_SERVER=https://@MATRIX_DOMAIN@
MATRIX_SERVER_NAME=@MATRIX_DOMAIN@
MATRIX_PORT=8008
API_HOST=https://@PRODUCT_DOMAIN@
EXCHANGE_PORT=3000
PWA_PORT=3002
SSL_EMAIL=@SSL_EMAIL@

# Matrix rooms and accounts
ROOM_VERSION=12
SUPPLY_INDEX_ROOM_ALIAS=#bytem-supply-index-room:@MATRIX_DOMAIN@
DEMAND_INDEX_ROOM_ALIAS=#bytem-demand-index-room:@MATRIX_DOMAIN@
MATRIX_ADMIN_USERNAME=@ADMIN_LOCALPART@
MATRIX_ADMIN_PASSWORD=@MATRIX_ADMIN_PASSWORD@
BOT_USERNAME=bot
BOT_PASSWORD=@BOT_PASSWORD@
BOT_USER_ID=@bot:@MATRIX_DOMAIN@
# Bot accounts on this homeserver that may create rooms: the bot_users list of the Synapse
# room-creator module, as exact MXIDs. Env values are flat, so the list is comma-separated:
#   BOT_USERS=@bot:@MATRIX_DOMAIN@
#   BOT_USERS=@bot:@MATRIX_DOMAIN@,@seeder:@MATRIX_DOMAIN@
# generate-configs.sh does not load that module yet, so nothing reads it for now.
BOT_USERS=@bot:@MATRIX_DOMAIN@
BOT_DEVICE_ID=bytem-bot
BOT_LOGIN_BACKOFF_MS=60000
# Exchange rooms are invite-only with members-only history. false: public, as before 2026-10.
EXCHANGE_ROOMS_PRIVATE=true
# SIGIL signature on exchanged data: Ed25519 seed, 64 hex chars. Empty: nothing is signed.
# env_setup.sh generates one unless SIGIL_PRIVATE_KEY is set in its environment.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SIGIL_PRIVATE_KEY=@SIGIL_PRIVATE_KEY@
# Stripe secret key (sk_test_... in a sandbox): creates and confirms Checkout payments for
# priced single-click access (exchange-v2 plan item 5). Empty: priced products return 503.
# env_setup.sh copies STRIPE_SECRET_KEY from its environment; it cannot be generated.
STRIPE_SECRET_KEY=@STRIPE_SECRET_KEY@
# Synapse/PostgreSQL secrets
POSTGRES_HOST=localhost
POSTGRES_USER=synapse
# Read by the postgres image and by synapse-config/generate-configs.sh.
POSTGRES_DB=synapse
POSTGRES_PORT=5432
POSTGRES_PASSWORD=@POSTGRES_PASSWORD@
SYNAPSE_MACAROON_SECRET_KEY=@SYNAPSE_MACAROON_SECRET_KEY@

# RabbitMQ. Its management API is also used to queue the post-migration reindex.
RABBITMQ_URL=amqp://@RABBITMQ_DEFAULT_USER@:@RABBITMQ_DEFAULT_PASS@@@PRODUCT_DOMAIN@:5672/bytem
RABBITMQ_DEFAULT_USER=@RABBITMQ_DEFAULT_USER@
RABBITMQ_DEFAULT_PASS=@RABBITMQ_DEFAULT_PASS@
RABBITMQ_DEFAULT_VHOST=bytem
# Consumer prefetch; the code default is 10 when unset.
RABBITMQ_PREFETCH=10

# Solr has no public port and no authentication plugin in this stack.
SOLR_URL=http://@PRODUCT_DOMAIN@:8983

# Application secret
JWT_SECRET=@JWT_SECRET@

# DOMAIN_LIST is the DEID domain list, not the markets (no service here reads it).
# Markets: FEDERATION_MARKET_LIST_URL, else MARKET_LIST. An entry is a product host
# (Matrix at matrix.<host>) or {"app":"bytem.de.cities.app","matrix":"matrix.de.cities.app"}.
DOMAIN_LIST=https://bytem.app/domain/domain-list.json
MARKET_LIST=@MARKET_LIST@
FEDERATION_MARKET_LIST_URL=@FEDERATION_MARKET_LIST_URL@
# The product the /demand page features and llms.txt uses as its example.
# Optional: unset, /demand falls back to the first indexed product.
NEXT_PUBLIC_DEMAND_PRODUCT_DEID=

# Indexing and service tuning
INDEX_SNAPSHOT_REFRESH_MS=30000
INDEX_REFRESH_MS=7200000
INDEX_REFRESH_CONCURRENCY=20
DEMAND_CREATE_RATE_LIMIT=50
DEMAND_CREATE_RATE_WINDOW_MS=60000
INDEX_AUTO_REINDEX=on
INDEX_AUTO_REINDEX_MS=600000
INDEX_AUTO_REINDEX_BATCH=500
INDEX_AUTO_REINDEX_COOLDOWN_MS=21600000
INDEX_AUTO_REINDEX_START_MS=120000
DQ_CONCURRENCY=2
DQ_DEBOUNCE_MS=5000
DQ_OBSERVATION_TTL_MS=604800000
DQ_FETCH_TIMEOUT_MS=10000
DQ_FETCH_MAX_BYTES=8388608
BOT_PORT=4000
AXIOS_REQUEST_TIMEOUT_MS=30000
MAX_FILE_SIZE=52428800
# Datenservice+ credentials are resolved by the supply bot only. Never place
# their values in a Matrix event or frontend environment variable.
DATENSERVICEPLUS_CLIENT_ID=
DATENSERVICEPLUS_CLIENT_SECRET=
DATENSERVICEPLUS_API_KEY=
FEDERATION_ENABLED=true
# generate-configs.sh: homeservers always whitelisted on top of the market list,
# and whether a market list that fails to load aborts the boot (1) or yields
# an own-domain-only whitelist (0).
FEDERATION_EXTRA_DOMAINS=matrix.org
FEDERATION_STRICT=0
# Extra CORS origins for development, comma-separated (e.g. a PWA dev server).
# Leave empty in production: API_HOST and DOMAIN_NAME are always allowed.
CORS_EXTRA_ORIGINS=
# certbot.sh renews a certificate this many days before it expires.
RENEW_BEFORE_DAYS=30
LOG_LEVEL=debug

# Optional. Read by synapse-config/generate-configs.sh and docker-compose.yaml
# with these defaults when unset; uncomment to override on this host.
# Shared-secret registration for Synapse. Unset, the generator mints a throwaway
# per boot, so the route is unusable; set a stable value only if you need it.
#REGISTRATION_SHARED_SECRET=
# Synapse form_secret; unset, Synapse generates its own.
#SYNAPSE_FORM_SECRET=
# Synapse caches.global_factor.
#SYNAPSE_CACHE_FACTOR=2.0
# PostgreSQL memory for the Synapse database container.
#PG_SHARED_BUFFERS=1GB
#PG_EFFECTIVE_CACHE_SIZE=3GB

# Secret in the shareable link https://<DOMAIN_NAME>/traffic-report.html?secret=<value>
# Letters, digits, - _ . ~ only.
TRAFFIC_REPORT_SECRET=@TRAFFIC_REPORT_SECRET@
